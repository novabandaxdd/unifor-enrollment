# Normalize line endings to LF on commit, checkout as LF on Unix / CRLF on Windows
* text=auto eol=lf

# Force LF for shell scripts
*.sh text eol=lf
mvnw text eol=lf

# Force CRLF for Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files — no conversion
*.jar binary
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
