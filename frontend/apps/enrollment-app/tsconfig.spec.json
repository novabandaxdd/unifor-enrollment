{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "types": ["jest", "node"],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "keycloak-js": ["node_modules/keycloak-js/lib/keycloak.d.ts"],
      "@unifor/shared-auth": ["libs/shared-auth/src/index.ts"],
      "@unifor/shared-data-access": ["libs/shared-data-access/src/index.ts"],
      "@unifor/shared-ui": ["libs/shared-ui/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.d.ts",
    "src/test-setup.ts"
  ]
}
