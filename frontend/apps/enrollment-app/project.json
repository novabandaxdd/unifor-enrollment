{
  "name": "enrollment-app",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/enrollment-app/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/enrollment-app",
        "index": "apps/enrollment-app/src/index.html",
        "browser": "apps/enrollment-app/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/enrollment-app/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/enrollment-app/public"
          }
        ],
        "styles": ["apps/enrollment-app/src/styles.scss"],
        "scripts": []
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "800kB",
              "maximumError": "2MB"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kB",
              "maximumError": "10kB"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "enrollment-app:build:production"
        },
        "development": {
          "buildTarget": "enrollment-app:build:development"
        }
      },
      "defaultConfiguration": "development",
      "options": {
        "port": 4200
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "enrollment-app:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/enrollment-app/**/*.ts", "apps/enrollment-app/**/*.html"]
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/apps/enrollment-app"],
      "options": {
        "jestConfig": "apps/enrollment-app/jest.config.js"
      }
    }
  }
}
