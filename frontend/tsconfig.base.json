{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@unifor/shared-ui": ["libs/shared-ui/src/index.ts"],
      "@unifor/shared-data-access": ["libs/shared-data-access/src/index.ts"],
      "@unifor/shared-auth": ["libs/shared-auth/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
